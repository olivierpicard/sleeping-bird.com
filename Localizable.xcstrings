    "store.error.verification" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your purchase went through, but we couldn't confirm it on this device. Tap Restore Purchases to unlock — you won't be charged again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu compra se realizó, pero no pudimos confirmarla en este dispositivo. Toca Restaurar compras para acceder; no se te volverá a cobrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre achat a bien été effectué, mais nous n'avons pas pu le confirmer sur cet appareil. Touchez Restaurer les achats pour y accéder — vous ne serez pas débité une seconde fois."
          }
