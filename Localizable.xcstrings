    "Arper Bird" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arper Bird"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arper Bird"
          }
        }
      }
    },
    "Arper Bird is provided “as is.” It is not a medical, financial, or professional advice tool. Decisions you make based on your tracked data are your own." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arper Bird se ofrece «tal cual». No es una herramienta de asesoramiento médico, financiero ni profesional. Las decisiones que tomes a partir de tus datos son tu responsabilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arper Bird est fourni « en l'état ». Il ne s'agit pas d'un outil de conseil médical, financier ou professionnel. Les décisions que vous prenez sur la base de vos données vous appartiennent."
          }
        }
      }
    },
    "Ate Healthy" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comí saludable"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangé sainement"
          }
        }
      }
    },
    "By continuing, you agree to our [Terms and Privacy Policy](arperbird://legal)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al continuar, aceptas nuestros [Términos y política de privacidad](arperbird://legal)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En continuant, vous acceptez nos [Conditions et politique de confidentialité](arperbird://legal)."
          }
        }
      }
    },
    "By using Arper Bird you agree to these terms. The app lets you describe metrics you want to track, interprets your description with AI, and renders charts to help you visualize your personal data." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al usar Arper Bird, aceptas estos términos. La aplicación te permite describir las métricas que quieres seguir, interpreta tu descripción con IA y genera gráficos para ayudarte a visualizar tus datos personales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En utilisant Arper Bird, vous acceptez ces conditions. L'application vous permet de décrire les mesures que vous souhaitez suivre, interprète votre description grâce à l'IA et génère des graphiques pour vous aider à visualiser vos données personnelles."
          }
        }
      }
    },
