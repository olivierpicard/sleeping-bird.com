    "metric_input_sheet.mic_permission.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice dictation needs access to your microphone. Turn it on in Settings to dictate your metric."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dictado por voz necesita acceder al micrófono. Actívalo en Ajustes para dictar tu métrica."
