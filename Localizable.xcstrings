        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n\n———\nPor favor, conserva la información de abajo para que podamos ayudarte:\nVersión de la app: %1$@ (%2$@)\nDispositivo: %3$@\nID de cuenta: %4$@"
