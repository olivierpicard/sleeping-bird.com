    "What do you want to track?" : {

    },
    "What I liked:\n\n\nWhat's buggy / bothered me:\n\n\nAn idea:\n\n\n---\nVersion: %1$@ (%2$@)\nDevice: %3$@ — iOS %4$@\nLocale: %5$@\nID: %6$@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que me gustó:\n\n\nLo que falla / me molestó:\n\n\nUna idea:\n\n\n---\nVersión: %1$@ (%2$@)\nDispositivo: %3$@ — iOS %4$@\nIdioma: %5$@\nID: %6$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui m'a plu :\n\n\nCe qui bug / m'a gêné :\n\n\nUne idée :\n\n\n---\nVersion : %1$@ (%2$@)\nAppareil : %3$@ — iOS %4$@\nLangue : %5$@\nID : %6$@"
          }
        }
      }
    },
