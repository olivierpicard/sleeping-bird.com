{
  "type": "object",
  "properties": {
    "suggestions": {
      "type": "array",
      "description": "A list of 1 to 3 tracking configurations based on the user's intent.",
      "items": {
        "type": "object",
        "properties": {
          "metric_name": {
            "type": "string",
            "description": "Concise, title-cased name. E.g., 'Daily Hydration', 'Deep Sleep Duration', 'Anxiety Level'."
          },
          "data_type": {
            "type": "string",
            "description": "The primitive type of data being recorded.",
            "enum": [
              "category_single",
              "category_multiple",
              "duration",
              "date_time",
              "binary",
              "number"
            ]
          },
          "fit_probability": {
            "type": "number",
            "description": "Confidence score [0.0 to 1.0]. Use 1.0 only if the user's intent is unambiguous (e.g., 'Track steps'). Use values < 1.0 to offer multiple perspectives for vague intents (e.g., 'Track my runs' could be 0.8 for duration and 0.2 for number of laps).",
            "maximum": 1
          },
          "config": {
            "type": "object",
            "description": "Type-specific configuration. Only the key matching 'data_type' must be populated.",
            "properties": {
              "bounded_number": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "min": {
                    "type": "number",
                    "description": "Lower bound. E.g., 0 for weight, 1 for a 1-10 scale."
                  },
                  "max": {
                    "type": "number",
                    "description": "Upper bound. E.g., 500 daily carbs, 10 for pain levels."
                  },
                  "granularity": {
                    "type": "number",
                    "description": "Increment step. E.g., 1 for counts, 0.1 for precise weight, 0.25 for quarter increments, 0.5, 0.01, 2, 5, 10, ..."
                  },
                  "unit": {
                    "type": "string",
                    "description": "Display unit. E.g., 'kg', 'steps', 'kcal', 'cup'."
                  },
                  "goal": {
                    "type": "number",
                    "description": "Optional target value. E.g., 2000 calories."
                  }
                },
                "required": [
                  "min",
                  "max",
                  "granularity"
                ],
                "propertyOrdering": [
                  "min",
                  "max",
                  "granularity",
                  "unit",
                  "goal"
                ]
              },
              "category": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "labels": {
                    "type": "array",
                    "description": "List of options. E.g., ['Great', 'Good', 'Meh', 'Bad'] or ['Chest Day', 'Legs', 'Cardio'].",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 2,
                    "maxItems": 15
                  }
                },
                "required": [
                  "labels"
                ],
                "propertyOrdering": [
                  "labels"
                ]
              },
              "duration": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "granularity": {
                    "type": "string",
                    "description": "The smallest unit of input allowed. 's' allows seconds, 'm' limits to minutes/hours.",
                    "enum": [
                      "ms",
                      "s",
                      "m",
                      "h"
                    ]
                  },
                  "max": {
                    "type": "number",
                    "description": "Expected max duration in SECONDS. If > 3600, UI shows H/M/S. If < 3600, UI shows M/S. E.g., 7200 for a 2h workout."
                  }
                },
                "required": [
                  "granularity",
                  "max"
                ],
                "propertyOrdering": [
                  "granularity",
                  "max"
                ]
              },
              "binary": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "true_label": {
                    "type": "string",
                    "description": "E.g., 'Did it', 'Yes', 'Took Meds'."
                  },
                  "false_label": {
                    "type": "string",
                    "description": "E.g., 'Missed', 'No', 'Sober'."
                  }
                },
                "required": [
                  "true_label",
                  "false_label"
                ],
                "propertyOrdering": [
                  "true_label",
                  "false_label"
                ]
              }
            },
            "propertyOrdering": [
              "bounded_number",
              "category",
              "duration",
              "binary"
            ]
          }
        },
        "required": [
          "metric_name",
          "data_type",
          "fit_probability",
          "config"
        ],
        "propertyOrdering": [
          "metric_name",
          "data_type",
          "fit_probability",
          "config"
        ]
      },
      "minItems": 1,
      "maxItems": 3
    }
  },
  "required": [
    "suggestions"
  ],
  "propertyOrdering": [
    "suggestions"
  ]
}
