{
  "openapi": "3.1.0",
  "info": {
    "title": "Sleeping Bird API",
    "version": "1.0.0"
  },
  "paths": {
    "/generate": {
      "get": {
        "operationId": "generate",
        "summary": "Generate tracking suggestions from a user prompt.",
        "parameters": [
          {
            "in": "query",
            "name": "prompt",
            "schema": {
              "type": "string",
              "description": "The user's free-form tracking intent."
            },
            "required": true,
            "description": "The user's free-form tracking intent."
          }
        ],
        "responses": {
          "200": {
            "description": "Generated suggestions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "response": {
                      "type": "object",
                      "properties": {
                        "suggestions": {
                          "minItems": 1,
                          "maxItems": 3,
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Suggestion"
                          },
                          "description": "A list of 1 to 3 tracking configurations based on the user's intent."
                        }
                      },
                      "required": [
                        "suggestions"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "response"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid prompt.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "Generation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Suggestion": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/NumberSuggestion"
          },
          {
            "$ref": "#/components/schemas/CategorySingleSuggestion"
          },
          {
            "$ref": "#/components/schemas/CategoryMultipleSuggestion"
          },
          {
            "$ref": "#/components/schemas/DurationSuggestion"
          },
          {
            "$ref": "#/components/schemas/BinarySuggestion"
          },
          {
            "$ref": "#/components/schemas/DateTimeSuggestion"
          }
        ],
        "discriminator": {
          "propertyName": "dataType",
          "mapping": {
            "number": "#/components/schemas/NumberSuggestion",
            "categorySingle": "#/components/schemas/CategorySingleSuggestion",
            "categoryMultiple": "#/components/schemas/CategoryMultipleSuggestion",
            "duration": "#/components/schemas/DurationSuggestion",
            "binary": "#/components/schemas/BinarySuggestion",
            "dateTime": "#/components/schemas/DateTimeSuggestion"
          }
        },
        "type": "object"
      },
      "NumberSuggestion": {
        "type": "object",
        "properties": {
          "metricName": {
            "type": "string",
            "description": "Concise, title-cased name. E.g., 'Daily Hydration', 'Deep Sleep Duration', 'Anxiety Level'.",
            "example": "Daily Hydration"
          },
          "fitProbability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence score [0.0 to 1.0]. Use 1.0 only if the user's intent is unambiguous (e.g., 'Track steps'). Use values < 1.0 to offer multiple perspectives for vague intents (e.g., 'Track my runs' could be 0.8 for duration and 0.2 for number of laps).",
            "example": 0.9
          },
          "dataType": {
            "type": "string",
            "const": "number"
          },
          "min": {
            "type": "number",
            "description": "Lower bound. E.g., 0 for weight, 1 for a 1-10 scale.",
            "example": 0
          },
          "max": {
            "type": "number",
            "description": "Upper bound. E.g., 500 daily carbs, 10 for pain levels.",
            "example": 500
          },
          "granularity": {
            "type": "number",
            "description": "Increment step. E.g., 1 for counts, 0.1 for precise weight, 0.25 for quarter increments, 0.5, 0.01, 2, 5, 10, ...",
            "example": 1
          },
          "unit": {
            "description": "Display unit. E.g., 'kg', 'steps', 'kcal', 'cup'.",
            "example": "kcal",
            "type": "string"
          },
          "goal": {
            "description": "Optional target value. E.g., 2000 calories.",
            "example": 2000,
            "type": "number"
          }
        },
        "required": [
          "metricName",
          "fitProbability",
          "dataType",
          "min",
          "max",
          "granularity"
        ],
        "additionalProperties": false,
        "description": "Track a numeric value within a defined range. E.g., weight, calories, pain level, steps."
      },
      "CategorySingleSuggestion": {
        "type": "object",
        "properties": {
          "metricName": {
            "type": "string",
            "description": "Concise, title-cased name. E.g., 'Daily Hydration', 'Deep Sleep Duration', 'Anxiety Level'.",
            "example": "Daily Hydration"
          },
          "fitProbability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence score [0.0 to 1.0]. Use 1.0 only if the user's intent is unambiguous (e.g., 'Track steps'). Use values < 1.0 to offer multiple perspectives for vague intents (e.g., 'Track my runs' could be 0.8 for duration and 0.2 for number of laps).",
            "example": 0.9
          },
          "dataType": {
            "type": "string",
            "const": "categorySingle"
          },
          "labels": {
            "minItems": 2,
            "maxItems": 15,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of mutually exclusive options. E.g., ['Great', 'Good', 'Meh', 'Bad'].",
            "example": [
              "Great",
              "Good",
              "Meh",
              "Bad"
            ]
          }
        },
        "required": [
          "metricName",
          "fitProbability",
          "dataType",
          "labels"
        ],
        "additionalProperties": false,
        "description": "Track a single choice from a fixed list. E.g., mood, workout type."
      },
      "CategoryMultipleSuggestion": {
        "type": "object",
        "properties": {
          "metricName": {
            "type": "string",
            "description": "Concise, title-cased name. E.g., 'Daily Hydration', 'Deep Sleep Duration', 'Anxiety Level'.",
            "example": "Daily Hydration"
          },
          "fitProbability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence score [0.0 to 1.0]. Use 1.0 only if the user's intent is unambiguous (e.g., 'Track steps'). Use values < 1.0 to offer multiple perspectives for vague intents (e.g., 'Track my runs' could be 0.8 for duration and 0.2 for number of laps).",
            "example": 0.9
          },
          "dataType": {
            "type": "string",
            "const": "categoryMultiple"
          },
          "labels": {
            "minItems": 2,
            "maxItems": 15,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of options, multiple can be selected. E.g., ['Chest', 'Legs', 'Cardio'].",
            "example": [
              "Chest",
              "Legs",
              "Cardio"
            ]
          }
        },
        "required": [
          "metricName",
          "fitProbability",
          "dataType",
          "labels"
        ],
        "additionalProperties": false,
        "description": "Track multiple choices from a fixed list. E.g., symptoms, workout muscles."
      },
      "DurationSuggestion": {
        "type": "object",
        "properties": {
          "metricName": {
            "type": "string",
            "description": "Concise, title-cased name. E.g., 'Daily Hydration', 'Deep Sleep Duration', 'Anxiety Level'.",
            "example": "Daily Hydration"
          },
          "fitProbability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence score [0.0 to 1.0]. Use 1.0 only if the user's intent is unambiguous (e.g., 'Track steps'). Use values < 1.0 to offer multiple perspectives for vague intents (e.g., 'Track my runs' could be 0.8 for duration and 0.2 for number of laps).",
            "example": 0.9
          },
          "dataType": {
            "type": "string",
            "const": "duration"
          },
          "granularity": {
            "type": "string",
            "enum": [
              "ms",
              "s",
              "m",
              "h"
            ],
            "description": "The smallest unit of input allowed. 's' allows seconds, 'm' limits to minutes/hours.",
            "example": "m"
          },
          "max": {
            "type": "number",
            "description": "Expected max duration in SECONDS. If > 3600, UI shows H/M/S. If < 3600, UI shows M/S. E.g., 7200 for a 2h workout.",
            "example": 7200
          }
        },
        "required": [
          "metricName",
          "fitProbability",
          "dataType",
          "granularity",
          "max"
        ],
        "additionalProperties": false,
        "description": "Track an elapsed time. E.g., workout duration, sleep, meditation session."
      },
      "BinarySuggestion": {
        "type": "object",
        "properties": {
          "metricName": {
            "type": "string",
            "description": "Concise, title-cased name. E.g., 'Daily Hydration', 'Deep Sleep Duration', 'Anxiety Level'.",
            "example": "Daily Hydration"
          },
          "fitProbability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence score [0.0 to 1.0]. Use 1.0 only if the user's intent is unambiguous (e.g., 'Track steps'). Use values < 1.0 to offer multiple perspectives for vague intents (e.g., 'Track my runs' could be 0.8 for duration and 0.2 for number of laps).",
            "example": 0.9
          },
          "dataType": {
            "type": "string",
            "const": "binary"
          },
          "trueLabel": {
            "type": "string",
            "description": "E.g., 'Did it', 'Yes', 'Took Meds'.",
            "example": "Took Meds"
          },
          "falseLabel": {
            "type": "string",
            "description": "E.g., 'Missed', 'No', 'Sober'.",
            "example": "Missed"
          }
        },
        "required": [
          "metricName",
          "fitProbability",
          "dataType",
          "trueLabel",
          "falseLabel"
        ],
        "additionalProperties": false,
        "description": "Track a yes/no habit or event. E.g., took medication, exercised today."
      },
      "DateTimeSuggestion": {
        "type": "object",
        "properties": {
          "metricName": {
            "type": "string",
            "description": "Concise, title-cased name. E.g., 'Daily Hydration', 'Deep Sleep Duration', 'Anxiety Level'.",
            "example": "Daily Hydration"
          },
          "fitProbability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence score [0.0 to 1.0]. Use 1.0 only if the user's intent is unambiguous (e.g., 'Track steps'). Use values < 1.0 to offer multiple perspectives for vague intents (e.g., 'Track my runs' could be 0.8 for duration and 0.2 for number of laps).",
            "example": 0.9
          },
          "dataType": {
            "type": "string",
            "const": "dateTime"
          }
        },
        "required": [
          "metricName",
          "fitProbability",
          "dataType"
        ],
        "additionalProperties": false,
        "description": "Track a point in time. E.g., bedtime, appointment."
      }
    }
  }
}