{
  "openapi": "3.1.0",
  "info": {
    "title": "Sleeping Bird API",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/generate": {
      "get": {
        "summary": "Generated metric suggestions",
        "operationId": "generate_generate_get",
        "parameters": [
          {
            "name": "prompt",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "User prompt to generate a metric suggestion",
              "title": "Prompt"
            },
            "description": "User prompt to generate a metric suggestion"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing prompt parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Gemini API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BinaryTracker": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "binary",
            "title": "Kind"
          },
          "trueLabel": {
            "type": "string",
            "title": "Truelabel",
            "description": "E.g., 'Did it', 'Yes', 'Took Meds'.",
            "examples": [
              "Took Meds"
            ]
          },
          "falseLabel": {
            "type": "string",
            "title": "Falselabel",
            "description": "E.g., 'Missed', 'No', 'Sober'.",
            "examples": [
              "Missed"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "trueLabel",
          "falseLabel"
        ],
        "title": "BinaryTracker",
        "description": "Track a yes/no habit or event. E.g., took medication, exercised today."
      },
      "CategoryMultipleTracker": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "categoryMultiple",
            "title": "Kind"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 15,
            "minItems": 2,
            "title": "Labels",
            "description": "Options where multiple can be selected. E.g., ['Chest', 'Legs', 'Cardio'].",
            "examples": [
              [
                "Chest",
                "Legs",
                "Cardio"
              ]
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "labels"
        ],
        "title": "CategoryMultipleTracker",
        "description": "Track multiple choices from a fixed list. E.g., symptoms, workout muscles."
      },
      "CategorySingleTracker": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "categorySingle",
            "title": "Kind"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 15,
            "minItems": 2,
            "title": "Labels",
            "description": "Mutually exclusive options. E.g., ['Great', 'Good', 'Meh', 'Bad'].",
            "examples": [
              [
                "Great",
                "Good",
                "Meh",
                "Bad"
              ]
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "labels"
        ],
        "title": "CategorySingleTracker",
        "description": "Track a single choice from a fixed list. E.g., mood, workout type."
      },
      "DateTimeTracker": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "dateTime",
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "DateTimeTracker",
        "description": "Track a point in time. E.g., bedtime, appointment."
      },
      "DurationTracker": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "duration",
            "title": "Kind"
          },
          "granularity": {
            "type": "string",
            "enum": [
              "ms",
              "s",
              "m",
              "h"
            ],
            "title": "Granularity",
            "description": "Smallest unit of input allowed. 's' allows seconds, 'm' limits to minutes/hours.",
            "examples": [
              "m"
            ]
          },
          "maxInSeconds": {
            "type": "number",
            "title": "Maxinseconds",
            "description": "Expected max duration in SECONDS.  E.g., 7200 for a 2h workout.",
            "examples": [
              7200,
              60,
              1800
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "granularity",
          "maxInSeconds"
        ],
        "title": "DurationTracker",
        "description": "Track an elapsed time. E.g., workout duration, sleep, meditation."
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "GenerateResponse": {
        "properties": {
          "response": {
            "$ref": "#/components/schemas/SuggestionsSchema"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "response"
        ],
        "title": "GenerateResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NumberTracker": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "number",
            "title": "Kind",
            "description": "kind of tracker"
          },
          "min": {
            "type": "number",
            "title": "Min",
            "description": "Lower bound. E.g., 0 for weight, 1 for a 1-10 scale.",
            "examples": [
              0
            ]
          },
          "max": {
            "type": "number",
            "title": "Max",
            "description": "Upper bound. E.g., 500 daily carbs, 10 for pain levels.",
            "examples": [
              500
            ]
          },
          "granularity": {
            "type": "number",
            "title": "Granularity",
            "description": "Increment step. E.g., 1 for counts, 0.1 for precise weight, 0.5, 0.01, 5, 10, ...",
            "examples": [
              1
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit",
            "description": "Display unit. E.g., 'kg', 'steps', 'kcal'.",
            "examples": [
              "kcal"
            ]
          },
          "goal": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal",
            "description": "Optional target value. E.g., 2000 calories.",
            "examples": [
              2000
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "min",
          "max",
          "granularity"
        ],
        "title": "NumberTracker",
        "description": "Track a numeric value within a defined range. E.g., weight, calories, pain level, steps."
      },
      "Suggestion": {
        "properties": {
          "metricName": {
            "type": "string",
            "title": "Metricname",
            "description": "Concise, title-cased name. E.g., 'Daily Hydration', 'Deep Sleep Duration', 'Anxiety Level'.",
            "examples": [
              "Daily Hydration"
            ]
          },
          "fitProbability": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Fitprobability",
            "description": "Confidence score [0.0 to 1.0]. Use 1.0 only if the user's intent is unambiguous (e.g., 'Track steps'). Use values < 1.0 to offer multiple perspectives for vague intents.",
            "examples": [
              0.9
            ]
          },
          "tracker": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NumberTracker"
              },
              {
                "$ref": "#/components/schemas/CategorySingleTracker"
              },
              {
                "$ref": "#/components/schemas/CategoryMultipleTracker"
              },
              {
                "$ref": "#/components/schemas/DurationTracker"
              },
              {
                "$ref": "#/components/schemas/BinaryTracker"
              },
              {
                "$ref": "#/components/schemas/DateTimeTracker"
              }
            ],
            "title": "Tracker"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "metricName",
          "fitProbability",
          "tracker"
        ],
        "title": "Suggestion"
      },
      "SuggestionsSchema": {
        "properties": {
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/Suggestion"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Suggestions",
            "description": "A list of 1 to 3 tracking configurations based on the user's intent."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "suggestions"
        ],
        "title": "SuggestionsSchema"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}